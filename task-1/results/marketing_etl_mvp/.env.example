# Airflow UID (set to your user ID on Linux)
AIRFLOW_UID=50000

# Airflow Web UI credentials
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Database settings
DB_HOST=postgres
DB_PORT=5432
DB_NAME=marketing_db
DB_USER=postgres
DB_PASSWORD=postgres

# CSV file path
CSV_FILE_PATH=/opt/airflow/data/deliveries.csv

# Email settings
SMTP_HOST=mailhog
SMTP_PORT=1025
FROM_EMAIL=airflow@example.com
TO_EMAIL=marketing@example.com
